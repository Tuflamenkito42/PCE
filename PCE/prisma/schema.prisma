// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  fullName  String?  @map("full_name")
  dni       String?  @unique
  role      String?  @default("public")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Affiliation {
  id               Int      @id @default(autoincrement())
  name             String
  lastname         String
  dni              String   @unique
  birthdate        DateTime?
  email            String
  phone            String?
  quota            Decimal  @db.Decimal(10, 2)
  message          String?  @db.Text
  cardPhotoPath    String?  @map("card_photo_path")
  cardPhotoMime    String?  @map("card_photo_mime")
  photoUrl         String?  @map("photo_url")
  paymentIntentId String?  @map("payment_intent_id")
  status           String?  @default("pending")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("affiliations")
}

model Donation {
  id               Int      @id @default(autoincrement())
  name             String?
  email            String?
  amount           Decimal  @db.Decimal(10, 2)
  message          String?  @db.Text
  paymentIntentId String?  @map("payment_intent_id")
  status           String?  @default("pending")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("donations")
}

model NewsletterSubscriber {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  subscribedAt DateTime @default(now()) @map("subscribed_at")
  active       Boolean  @default(true)

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  status    String?  @default("new")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model Vote {
  id              Int      @id @default(autoincrement())
  pollTitle       String   @map("poll_title")
  optionSelected  String   @map("option_selected")
  userId          Int?     @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("votes")
}

model JobApplication {
  id             Int      @id @default(autoincrement())
  offerId        String   @map("offer_id")
  fullName       String   @map("full_name")
  email          String
  phone          String
  city           String
  availability   String
  motivation     String   @db.Text
  cvFilePath     String?  @map("cv_file_path")
  cvOriginalName String?  @map("cv_original_name")
  cvMimeType     String?  @map("cv_mime_type")
  status         String?  @default("new")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([status], map: "idx_job_status")
  @@index([createdAt], map: "idx_job_created_at")
  @@map("job_applications")
}

model CarnetOrder {
  id              Int      @id @default(autoincrement())
  userId          Int?     @map("user_id")
  fullName        String   @map("full_name")
  email           String
  phone           String?
  address         String?
  city            String?
  postalCode      String?  @map("postal_code")
  country         String?
  nif             String?
  numeroSocio     String?  @map("numero_socio")
  amount          Decimal  @default(5.00) @db.Decimal(10, 2)
  paymentIntentId String?  @map("payment_intent_id")
  status          String?  @default("completed")
  shippingStatus  String?  @default("pending") @map("shipping_status")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([email], map: "idx_carnet_email")
  @@index([status], map: "idx_carnet_status")
  @@index([shippingStatus], map: "idx_carnet_shipping_status")
  @@index([createdAt], map: "idx_carnet_created_at")
  @@map("carnet_orders")
}
